{
  "openapi": "3.0.3",
  "info": {
    "title": "Task & Trivia API",
    "version": "1.0",
    "description": "SQLite-backed task CRUD plus an AI-generated trivia quiz.\n\n**Task API**\n- `GET /tasks`\n- `GET /tasks/{id}`\n- `POST /tasks`\n- `PUT /tasks/{id}`\n- `DELETE /tasks/{id}`\n\n**Trivia API**\n- `POST /quiz`"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "Task API",
      "description": "Create, read, update, and delete tasks stored in SQLite."
    },
    {
      "name": "Trivia API",
      "description": "Generate a structured multiple-choice quiz through the configured AI provider."
    }
  ],
  "paths": {
    "/tasks": {
      "get": {
        "tags": ["Task API"],
        "summary": "List tasks",
        "operationId": "listTasks",
        "parameters": [
          {
            "name": "done",
            "in": "query",
            "description": "Filter by completion status",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Filter tasks whose title contains this word",
            "schema": {
              "type": "string",
              "example": "milk"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching tasks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Task API"],
        "summary": "Create a task",
        "operationId": "createTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "title is required and cannot be empty"
                }
              }
            }
          }
        }
      }
    },
    "/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Task id",
          "schema": {
            "type": "integer",
            "example": 1
          }
        }
      ],
      "get": {
        "tags": ["Task API"],
        "summary": "Get one task",
        "operationId": "getTask",
        "responses": {
          "200": {
            "description": "Task found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task 99 not found"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": ["Task API"],
        "summary": "Update a task",
        "operationId": "updateTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTaskRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "emptyBody": {
                    "value": {
                      "error": "request body must include title and/or done"
                    }
                  },
                  "emptyTitle": {
                    "value": {
                      "error": "title cannot be empty"
                    }
                  },
                  "invalidDone": {
                    "value": {
                      "error": "done must be a boolean"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task 99 not found"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Task API"],
        "summary": "Delete a task",
        "operationId": "deleteTask",
        "responses": {
          "204": {
            "description": "Task deleted"
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Task 99 not found"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "get": {
        "tags": ["Task API"],
        "summary": "Task counts",
        "operationId": "getStats",
        "responses": {
          "200": {
            "description": "Aggregate task statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/quiz": {
      "post": {
        "tags": ["Trivia API"],
        "summary": "Generate a trivia quiz",
        "operationId": "createQuiz",
        "description": "Validates the request, asks the configured AI provider for a structured quiz, then returns the quiz only if the response passes schema validation.\n\n**Request rules**\n- `topic` is required and cannot be empty\n- `difficulty` must be `easy`, `medium`, or `hard`\n- `amount` must be an integer from 1 to 10\n\nInvalid requests return `400` and never call the AI provider.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateQuizRequest"
              },
              "example": {
                "topic": "JavaScript",
                "difficulty": "easy",
                "amount": 5
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated quiz from the AI provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Quiz"
                },
                "example": {
                  "topic": "JavaScript",
                  "difficulty": "easy",
                  "questions": [
                    {
                      "question": "Which keyword declares a constant in JavaScript?",
                      "options": ["var", "let", "const", "constant"],
                      "correctAnswer": "const"
                    }
                  ],
                  "provider": "gemini",
                  "model": "gemini-3.5-flash"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body. The AI provider is not called.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingTopic": {
                    "summary": "Missing topic",
                    "value": {
                      "error": "topic is required and cannot be empty"
                    }
                  },
                  "invalidDifficulty": {
                    "summary": "Unsupported difficulty",
                    "value": {
                      "error": "difficulty must be one of: easy, medium, hard"
                    }
                  },
                  "invalidAmount": {
                    "summary": "Amount outside 1–10",
                    "value": {
                      "error": "amount must be an integer between 1 and 10"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server is missing AI provider configuration, such as an API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "GEMINI_API_KEY is not set"
                }
              }
            }
          },
          "502": {
            "description": "The AI provider failed, or the quiz JSON failed validation (malformed JSON, missing fields, wrong option count, or wrong number of questions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidJson": {
                    "value": {
                      "error": "AI returned invalid JSON"
                    }
                  },
                  "invalidShape": {
                    "value": {
                      "error": "AI quiz failed validation: quiz must contain exactly 5 questions"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trivia/question": {
      "get": {
        "tags": ["Trivia API"],
        "summary": "Generate one JavaScript trivia question",
        "operationId": "getTriviaQuestion",
        "description": "Sends a fixed prompt through the AI provider abstraction and returns the model text. Used to prove the provider connection.",
        "responses": {
          "200": {
            "description": "The AI provider generated a trivia question",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriviaQuestion"
                }
              }
            }
          },
          "500": {
            "description": "Server is missing AI provider configuration",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "GEMINI_API_KEY is not set"
                }
              }
            }
          },
          "502": {
            "description": "AI request failed or returned an empty response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "tags": ["Task API"],
        "summary": "Reset to seed data",
        "operationId": "resetTasks",
        "responses": {
          "200": {
            "description": "Seed tasks restored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "required": ["id", "title", "done", "created_at", "updated_at"],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Buy groceries"
          },
          "done": {
            "type": "boolean",
            "example": false
          },
          "created_at": {
            "type": "string",
            "example": "2026-07-24 09:15:00"
          },
          "updated_at": {
            "type": "string",
            "example": "2026-07-24 09:15:00"
          }
        }
      },
      "CreateTaskRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "example": "Buy milk"
          }
        }
      },
      "UpdateTaskRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "example": "Buy oat milk"
          },
          "done": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "CreateQuizRequest": {
        "type": "object",
        "required": ["topic", "difficulty", "amount"],
        "properties": {
          "topic": {
            "type": "string",
            "minLength": 1,
            "description": "Subject of the quiz. Required and cannot be empty.",
            "example": "JavaScript"
          },
          "difficulty": {
            "type": "string",
            "enum": ["easy", "medium", "hard"],
            "description": "Supported values: easy, medium, hard.",
            "example": "easy"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "Number of questions to generate. Must be an integer from 1 to 10.",
            "example": 5
          }
        }
      },
      "QuizQuestion": {
        "type": "object",
        "required": ["question", "options", "correctAnswer"],
        "properties": {
          "question": {
            "type": "string",
            "example": "What keyword declares a block-scoped variable in JavaScript?"
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string"
            },
            "example": ["var", "let", "const", "define"]
          },
          "correctAnswer": {
            "type": "string",
            "example": "let"
          }
        }
      },
      "Quiz": {
        "type": "object",
        "required": ["topic", "difficulty", "questions"],
        "properties": {
          "topic": {
            "type": "string",
            "example": "JavaScript"
          },
          "difficulty": {
            "type": "string",
            "example": "medium"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuizQuestion"
            }
          },
          "provider": {
            "type": "string",
            "example": "gemini"
          },
          "model": {
            "type": "string",
            "example": "gemini-3.5-flash"
          }
        }
      },
      "TriviaQuestion": {
        "type": "object",
        "required": ["prompt", "model", "text"],
        "properties": {
          "prompt": {
            "type": "string",
            "example": "Generate one trivia question about JavaScript."
          },
          "provider": {
            "type": "string",
            "example": "gemini"
          },
          "model": {
            "type": "string",
            "example": "gemini-3.5-flash"
          },
          "text": {
            "type": "string",
            "example": "What keyword declares a block-scoped variable in JavaScript?"
          }
        }
      },
      "Stats": {
        "type": "object",
        "required": ["total", "done", "open"],
        "properties": {
          "total": {
            "type": "integer",
            "example": 7
          },
          "done": {
            "type": "integer",
            "example": 3
          },
          "open": {
            "type": "integer",
            "example": 4
          }
        }
      }
    }
  }
}
